<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.designstudio.controller.MainController">

    <top>
        <HBox styleClass="top-bar" spacing="10">
            <Label text="Дизайн-студия" styleClass="app-title"/>
            <Button text="Клиенты" onAction="#showClients"/>
            <Button text="Дизайнеры" onAction="#showDesigners"/>
            <Button text="Заказы" onAction="#showOrders"/>
            <Button text="Статистика" onAction="#showStatistics"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>